# Groq API key; create one at https://console.groq.com/keys.
GROQ_API_KEY=

# Groq model ID; use openai/gpt-oss-120b from the Groq model catalog.
GROQ_MODEL=openai/gpt-oss-120b

# Tavily API key; get one from your dashboard at https://app.tavily.com.
TAVILY_API_KEY=

# Backend API base URL referenced by the bundled Next.js example; obtain it from your backend deployment settings.
API_URL=
