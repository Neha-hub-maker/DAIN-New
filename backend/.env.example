DATABASE_URL=postgresql+psycopg://dain_user:replace-with-a-long-unique-password@localhost:5432/dain

POSTGRES_PASSWORD=replace-with-a-long-unique-password

INSTITUTIONAL_EMAIL_DOMAIN=du.ac.bd

APP_ENV=development
DEBUG=true

VERIFICATION_TOKEN_TTL_MINUTES=60
SESSION_TOKEN_TTL_MINUTES=1440

EXPOSE_VERIFICATION_TOKEN_IN_RESPONSE=true

MEDIA_ROOT=uploads
MAX_UPLOAD_SIZE_BYTES=5242880
# Launch_DAIN_Platform.bat / Launch_FullStack.bat serve index.html at http://localhost:3000.
# Open the HTTP URL, not index.html via file:// (Origin null is not allowed).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Groq (reasoning) ---
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Tavily (web search) ---
# Get a key from https://app.tavily.com
TAVILY_API_KEY=
