# Database connection URI from your PostgreSQL host; postgres:// and postgresql:// use psycopg 3 automatically. URL-encode credentials. For Compose the host is db:5432 and the database/user are dain/dain_user.
DATABASE_URL=
# Local Compose database password you choose; set the same password (URL-encoded) in DATABASE_URL. Not used by the hosted API.
POSTGRES_PASSWORD=

# Deployment environment; set production in the host dashboard.
APP_ENV=production
# Disable SQL debug logging in production.
DEBUG=false
# Required DU email domain; departmental subdomains are also accepted.
INSTITUTIONAL_EMAIL_DOMAIN=du.ac.bd

# Verification email validity in minutes.
VERIFICATION_TOKEN_TTL_MINUTES=60
# Login session validity in minutes.
SESSION_TOKEN_TTL_MINUTES=1440
# Keep false in production; verification codes must only be delivered through SMTP.
EXPOSE_VERIFICATION_TOKEN_IN_RESPONSE=false

# Vercel's writable temporary upload directory is ephemeral, not durable storage; use uploads for local development.
MEDIA_ROOT=/tmp/dain-uploads
# Maximum upload size in bytes (5 MiB).
MAX_UPLOAD_SIZE_BYTES=5242880
# Comma-separated frontend origins (scheme + hostname + optional port, no path); whitespace/trailing slashes are stripped and empty entries ignored. Set HTTPS production origins in the dashboard; no wildcard or null origin.
# Production frontend origin only, without the repository path. For local launch scripts override with http://localhost:3000,http://127.0.0.1:3000; file:// is unsupported.
CORS_ORIGINS=https://neha-hub-maker.github.io
# Local Docker/Uvicorn only: trusted proxy IPs/CIDRs. Not a Vercel startup setting. For direct local access use 127.0.0.1; do not trust * on a public app port.
FORWARDED_ALLOW_IPS=
# Local Docker/Compose listening port; Vercel manages its own serverless listener. Not a Settings field.
PORT=8000

# Groq reasoning key from https://console.groq.com/keys (host dashboard secret).
GROQ_API_KEY=
# Groq model identifier; choose a model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-120b
# Tavily search/extract key from https://app.tavily.com (host dashboard secret).
TAVILY_API_KEY=

# SMTP hostname from your transactional email provider; required for production registration.
SMTP_HOST=
# SMTP port from the provider (usually 587 for STARTTLS or 465 for implicit TLS).
SMTP_PORT=587
# SMTP login from your email provider (host dashboard secret).
SMTP_USERNAME=
# SMTP password or application token from your email provider (host dashboard secret).
SMTP_PASSWORD=
# Sender address authorized by your email provider.
EMAIL_FROM=
# Use true for implicit TLS (normally port 465), false for STARTTLS (normally port 587).
SMTP_USE_SSL=false
